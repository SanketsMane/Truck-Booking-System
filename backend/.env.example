# Copy to .env.development (or .env.production) and fill in real values.

# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URL=mongodb://127.0.0.1:27017/sharetruck

# Auth
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

# Encrypts SMS/email provider credentials stored in the database (set via
# the admin Settings page, not env vars — see backend/utils/crypto.js).
# Generate with: openssl rand -hex 32
# Required in production; falls back to a deterministic dev-only key if
# unset locally.
ENCRYPTION_KEY=

# TEMPORARY / DEV ONLY: when set, this exact value is always accepted as a
# valid OTP for any mobile number, in addition to the real generated code
# (see authController.verifyOtp). Lets you test the app without a working
# SMS provider. Leave unset in production — config/validateEnv.js refuses
# to boot in production if this is set, since it's a full auth bypass.
MASTER_OTP=

# Web push (see backend/utils/webPush.js) — a local keypair, not a
# third-party credential, so no signup needed. Generate one with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Uploaded-file storage (KYC documents, truck photos — see
# backend/utils/objectStorage.js). "local" writes to backend/uploads/ on
# disk — fine for local dev, but most hosts (including this project's
# target of Render) wipe local disk on every restart/redeploy, so
# config/validateEnv.js refuses to boot in production with this set to
# anything but "s3".
#
# STORAGE_PROVIDER=s3 works with real AWS S3 or any S3-compatible store —
# Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO — just point
# S3_ENDPOINT at that provider's endpoint (leave unset for real AWS S3).
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bootstrap admin (see scripts/seedAdmin.js — run once per environment,
# safe to re-run). Set these to YOUR real mobile/email before seeding a
# production database — the script refuses to run in production without
# SEED_ADMIN_MOBILE set, since the dev fallback number belongs to no one.
SEED_ADMIN_MOBILE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
