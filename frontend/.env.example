# Copy to .env (or .env.local) and point at your running backend.
VITE_API_URL=http://localhost:3000

# Free API key from https://locationiq.com (free tier: 5,000 requests/day,
# no credit card) — powers the pickup/drop address autocomplete. Restrict it
# to your domain(s) in the LocationIQ dashboard once deployed.
VITE_LOCATIONIQ_TOKEN=
