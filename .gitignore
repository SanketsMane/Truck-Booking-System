# ShareTruck — root-level ignore rules.
# backend/ and frontend/ each have their own .gitignore for workspace-specific
# rules; this file covers the repo root and anything that applies across both.

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/

# ── Environment / secrets ───────────────────────────────────────────────
# Never commit real env files — only the checked-in .env.example templates.
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
!**/.env.example

# ── Build output ─────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime / process files ─────────────────────────────────────────────
*.pid
*.pid.lock
*.sock

# ── Local databases / dumps ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
backend/backups/
backups/

# ── Certificates / keys ──────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
!frontend/public/**/*.key

# ── Testing artifacts ─────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── AI tool / local assistant metadata (never part of the app itself) ────
.claude/
.cursor/

# ── Temp files ────────────────────────────────────────────────────────────
*.tmp
*.temp
.cache/

# ── Internal docs — not part of the public repo ───────────────────────────
# Whole folder excluded (product spec docs, ops runbook, local notes).
# The Cred.md line is kept as an explicit safety net even if the folder
# rule above it is ever narrowed later.
/Docs/
Docs/Cred.md

# ── Stray local files (personal exports, not app assets) ─────────────────
/ChatGPT Image*.png
