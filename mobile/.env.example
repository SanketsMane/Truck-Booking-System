# Copy to .env and fill in for local development.
#
# EXPO_PUBLIC_* vars are inlined into the app bundle at build/start time —
# see https://docs.expo.dev/guides/environment-variables/. Never put a
# secret in an EXPO_PUBLIC_ var; it ships readable inside the app binary.
#
# iOS Simulator can reach the backend via localhost directly.
# Android Emulator must use 10.0.2.2 instead of localhost to reach the host machine.
# A physical device (either platform) needs your machine's LAN IP, e.g. http://192.168.1.23:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Same LocationIQ token the web app uses (frontend/.env's VITE_LOCATIONIQ_TOKEN) —
# free tier, India-restricted. LocationField degrades to a plain free-text
# field if this is left blank.
EXPO_PUBLIC_LOCATIONIQ_TOKEN=

# The marketing site — used only to link out to pages this app doesn't
# duplicate natively (Terms, Privacy). Defaults to production if unset.
EXPO_PUBLIC_WEB_URL=https://truckgee.com
