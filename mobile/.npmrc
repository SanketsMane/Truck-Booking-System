# expo-router's web-support dependency tree (vaul -> @radix-ui/* -> react-dom)
# has peer ranges that npm's strict resolver can't fully reconcile against
# React 19 as of SDK 57 — a known, pre-existing tangle in expo-router's own
# tree, not something specific to this app's own dependencies. Doesn't
# affect the iOS/Android native builds this app actually ships to; only
# the optional `expo start --web` dev-preview target touches that code at
# all. legacy-peer-deps is the standard workaround during this transition.
legacy-peer-deps=true
